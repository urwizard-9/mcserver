# Copy to .env.trial. This template contains no actual secrets.
# Fill these after selecting LGMC and checking the client versions.
TRIAL_MC_IMAGE=
TRIAL_MC_VERSION=
TRIAL_PAPER_BUILD=
TRIAL_EULA=
TRIAL_RCON_PASSWORD=
# Local-only by default. Use the Mac's reserved LAN IP for phone testing.
TRIAL_BIND_IP=127.0.0.1
# Bedrock LAN testing: set the Mac LAN IP and Geyser advertise-addresses together.
TRIAL_BEDROCK_BIND_IP=127.0.0.1
